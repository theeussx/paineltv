# URL do backend central (troque pra wss:// em produção, com o domínio real).
CENTRAL_WS_URL=ws://localhost:3001

# Token deste local. Você recebe isso UMA VEZ quando o owner cria o local
# no painel (tela "Locais"). Se perder, peça pro owner rotacionar o token.
SITE_TOKEN=

# Opcional, só aparece nos logs locais do agente.
LOCATION_NAME=
