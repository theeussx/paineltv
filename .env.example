PORT=3001

# OBRIGATÓRIO: gere um valor aleatório longo, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# O servidor recusa subir com o valor padrão ou vazio.
JWT_SECRET=

# Origem do frontend (protocolo + host + porta exatos).
CORS_ORIGIN=http://localhost:5173

# PostgreSQL. Crie o banco antes (createdb paineltv) e rode `npm run migrate`
# uma vez pra criar as tabelas.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/paineltv

# Usados apenas pelo script src/scripts/create-owner.js (não é lido pela API HTTP).
# Se preferir, deixe em branco e o script pergunta interativamente no terminal.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
