PORT=3001
JWT_SECRET=please-change-this-secret
CORS_ORIGIN=http://localhost:5173

# IP local da TV (veja em: Configurações > Geral > Rede > Status da Rede)
TV_IP=192.168.1.100

# MAC address da TV (necessário pra ligar via Wake-on-LAN futuramente)
TV_MAC=AA:BB:CC:DD:EE:FF

TV_NAME=TV Sala

# Deixe vazio na primeira execução. Depois de aceitar o popup na TV,
# copie o token que aparecer no console pra cá.
TV_TOKEN=
