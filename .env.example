PORT=3001

# OBRIGATÓRIO: gere um valor aleatório longo, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# O servidor recusa subir com o valor padrão ou vazio.
JWT_SECRET=

CORS_ORIGIN=http://localhost:5173

# Usados apenas pelo script src/scripts/create-admin.js (não é lido pela API HTTP).
# Se preferir, deixe em branco e o script pergunta interativamente no terminal.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# IP local da TV (veja em: Configurações > Geral > Rede > Status da Rede)
TV_IP=

# MAC address da TV (necessário pra ligar via Wake-on-LAN futuramente)
TV_MAC=AA:BB:CC:DD:EE:FF

TV_NAME=

# Deixe vazio na primeira execução. Depois de aceitar o popup na TV,
# copie o token que aparecer no console pra cá.
TV_TOKEN=
